.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/
logs/
# Large results live outside git (lab.toml results_root); the top-level results/ keeps only the item-scrubbed cards
# and the manifest of results_root. Nested results/ folders stay ignored as before.
/results/*
!/results/cards/
!/results/MANIFEST.tsv
*/**/results/
directions/
*.pt
.DS_Store
# Downloaded benchmark data stays local (lab/data/README.md); the repo keeps counts and hashes only.
lab/data/*/raw/
