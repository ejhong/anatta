{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/tools/guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch -q private)",
      "Bash(date -u:*)",
      "Bash(python3 -I $CLAUDE_PROJECT_DIR/tools/tally.py:*)",
      "Bash(python3 -I lab/tools/tally.py:*)",
      "Bash(/Users/eugene/prj/align/anatta/.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)"
    ]
  }
}
